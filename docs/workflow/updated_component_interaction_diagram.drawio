        <mxCell id="user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#15324A;fontSize=17;fontStyle=1;fontColor=#15324A;spacing=12;align=left;verticalAlign=top;gradientColor=none;" value="End User / Decision Maker&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Views suburb comparison, predicted price, affordability indicators and explanation notes.&lt;/font&gt;" vertex="1">
