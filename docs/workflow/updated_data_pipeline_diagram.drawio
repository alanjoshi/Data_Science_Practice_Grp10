        <mxCell id="n_0" value="&lt;b&gt;1. Five raw CSV snapshots&lt;/b&gt;&lt;br&gt;&lt;br&gt;properties.csv • ERP.csv&lt;br&gt;annual_household_nt.csv&lt;br&gt;cash_rates.csv • cpi_index.csv" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="36" y="110" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_1" value="&lt;b&gt;2. Clean and filter sales&lt;/b&gt;&lt;br&gt;&lt;br&gt;15,423 raw rows → 8,209 retained&lt;br&gt;209 outside bounding box; 0 sign repairs&lt;br&gt;Price and land-area IQR filters applied" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="526" y="110" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_2" value="&lt;b&gt;3. Align external data to sale date&lt;/b&gt;&lt;br&gt;&lt;br&gt;ERP and NT-wide income: prior year&lt;br&gt;Cash rate: latest on/before sale date&lt;br&gt;CPI: prior quarter; release dates unchecked" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="526" y="330" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_3" value="&lt;b&gt;4. Split chronologically&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cutoff: 12 November 2024&lt;br&gt;6,541 training rows / 1,668 test rows&lt;br&gt;Preserve time order for evaluation" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="36" y="330" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_4" value="&lt;b&gt;5. Fit preparation on training data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Median fills; kNN land-area imputation&lt;br&gt;Rare-suburb grouping and OOF encoding&lt;br&gt;Reuse fitted preparation on held-out data" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="36" y="550" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_5" value="&lt;b&gt;6. Construct model features&lt;/b&gt;&lt;br&gt;&lt;br&gt;CBD distance, property type, market lags&lt;br&gt;Rates, CPI and policy indicators&lt;br&gt;Exclude price_per_sqm; final weights off" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="526" y="550" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_6" value="&lt;b&gt;7. Compare and select models&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linear Regression, Random Forest, XGBoost&lt;br&gt;Time CV and 12 quarterly backtests&lt;br&gt;Saved selection: XGBoost + policy features" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
          <mxGeometry x="526" y="770" width="438" height="185" as="geometry" />
        </mxCell>
        <mxCell id="n_7" value="&lt;b&gt;8. Refit and export artifacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Refit on 8,209 rows through Dec 2025&lt;br&gt;Model, metadata, app_reference.json&lt;br&gt;Predictions, metrics and model card" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=16;fontColor=#26384A;fillColor=#EAF2FA;strokeColor=#8BA7C2;">
